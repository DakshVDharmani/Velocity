{
  "name": "velocity-vcs", "private": true, "version": "1.0.0", "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w @velocity/api\" \"npm run dev -w @velocity/web\"",
    "build": "npm run build -w @velocity/web && npm run build -w @velocity/api && npm run build -w @velocity/cli",
    "test": "vitest run", "db:generate": "prisma generate", "db:push": "prisma db push", "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit", "test:e2e": "playwright test"
  },
  "dependencies": {"@prisma/client":"6.19.0", "zod":"^3.24.2"},
  "devDependencies": {"@playwright/test":"^1.51.1", "@types/node":"^22.13.10", "@types/supertest":"^6.0.2", "concurrently":"^9.1.2", "prisma":"6.19.0", "supertest":"^7.0.0", "tsx":"^4.19.3", "typescript":"~5.7.3", "vitest":"^3.0.8", "yaml":"^2.7.0"}
}
