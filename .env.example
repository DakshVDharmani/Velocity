# Copy to .env and fill in the secrets below.
# All storage is Supabase: Postgres for metadata, Storage (bucket "snapshots") for commit blobs.

# Supabase Postgres. Use the "Session pooler" URI (port 5432) from
# Supabase dashboard > Project Settings > Database. It is Prisma-compatible.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. From Supabase dashboard > Project Settings > API > service_role key.
# Required to read/write the private "snapshots" storage bucket. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=
DEMO_ENABLED=true
NODE_ENV=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
