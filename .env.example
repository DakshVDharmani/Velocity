# Copy to .env and fill in. Demo mode needs no external services.
# Set STORAGE_DRIVER=postgres to persist to Supabase/Postgres.
STORAGE_DRIVER=demo

# Supabase Postgres. Use the "Session pooler" URI (port 5432) from
# Supabase dashboard > Project Settings > Database. It is Prisma-compatible.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

REDIS_URL=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=4000
OBJECT_STORAGE_PATH=./data/objects
DATA_PATH=./data/workspace.json
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=
DEMO_ENABLED=true
NODE_ENV=development
